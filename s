-- Lifetime Buyer role without replacing Roblox Player or Players instances.
local AUTH_GROUP_ID = 35142985
local GROUP_ACCESS_SECONDS = 144000
local LIFETIME_GAMEPASS_ID = 1796942492

local function enableLifetimeGamepass()
    local playersService
    local localPlayer
    local ownsLifetimePass = false

    pcall(function()
        playersService = game:GetService("Players")
        localPlayer = playersService.LocalPlayer
        local marketplaceService = game:GetService("MarketplaceService")
        ownsLifetimePass = marketplaceService:UserOwnsGamePassAsync(localPlayer.UserId, LIFETIME_GAMEPASS_ID)
    end)

    if not ownsLifetimePass then
        return
    end

    -- Prefer direct hooks: they touch only the two authorization calls rather
    -- than every Roblox namecall made by the menu.
    if hookfunction then
        local originalGetRoleInGroup
        originalGetRoleInGroup = hookfunction(localPlayer.GetRoleInGroup, function(self, requestedGroupId)
            if self == localPlayer and requestedGroupId == AUTH_GROUP_ID then
                return "Lifetime Buyer"
            end
            return originalGetRoleInGroup(self, requestedGroupId)
        end)

        local originalGetRankInGroup
        originalGetRankInGroup = hookfunction(localPlayer.GetRankInGroup, function(self, requestedGroupId)
            if self == localPlayer and requestedGroupId == AUTH_GROUP_ID then
                return 255
            end
            return originalGetRankInGroup(self, requestedGroupId)
        end)
        return
    end

    -- Fallback for executors without hookfunction. Keep this global hook hot
    -- path-free for all calls that are not from the local player.
    if hookmetamethod and getnamecallmethod then
        local originalNamecall
        originalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            if self == localPlayer then
                local methodName = getnamecallmethod()
                if methodName == "GetRoleInGroup" and select(1, ...) == AUTH_GROUP_ID then
                    return "Lifetime Buyer"
                end
                if methodName == "GetRankInGroup" and select(1, ...) == AUTH_GROUP_ID then
                    return 255
                end
            end
            return originalNamecall(self, ...)
        end)
    end
end

